{
  "name": "docs-chat-service",
  "version": "1.0.0",
  "description": "RAG chatbot service for go-infra documentation using Mastra",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "embed": "tsx src/scripts/embed-docs.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mastra", "rag", "chatbot", "documentation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "^1.0.0",
    "@mastra/core": "latest",
    "@mastra/rag": "latest",
    "@mastra/libsql": "latest",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ai": "^4.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.0.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/markdown-it": "^13.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

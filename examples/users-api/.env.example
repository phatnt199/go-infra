# Application Configuration
APP_NAME=users-api
APP_ENV=development

# HTTP Server Configuration
FIBER_HTTP_OPTIONS_PORT=:8080
FIBER_HTTP_OPTIONS_HOST=localhost
FIBER_HTTP_OPTIONS_BASE_PATH=/api/v1
FIBER_HTTP_OPTIONS_NAME=Users API
FIBER_HTTP_OPTIONS_DEVELOPMENT=true

# Database Configuration
# For local development: use admin/123456 on port 54100
# For docker-based postgres: use postgres/postgres on port 5432
GORM_OPTIONS_TYPE=0
GORM_OPTIONS_HOST=localhost
GORM_OPTIONS_PORT=54100
GORM_OPTIONS_USER=admin
GORM_OPTIONS_PASSWORD=123456
GORM_OPTIONS_DBNAME=go-sandbox
GORM_OPTIONS_SSLMODE=false

# Migration Configuration
# For local development: use admin/123456 on port 54100
# For docker-based postgres: use postgres/postgres on port 5432
MIGRATION_OPTIONS_HOST=localhost
MIGRATION_OPTIONS_PORT=54100
MIGRATION_OPTIONS_USER=admin
MIGRATION_OPTIONS_PASSWORD=123456
MIGRATION_OPTIONS_DBNAME=go-sandbox
MIGRATION_OPTIONS_MIGRATIONS_DIR=migrations
MIGRATION_OPTIONS_SKIP_MIGRATION=false

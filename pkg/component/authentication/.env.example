# Authentication Component Environment Variables
# Copy this file to .env and configure for your environment

# JWT Configuration
AUTH_JWT_SECRET=change-this-secret-in-production-must-be-long-and-random
AUTH_JWT_ISSUER=go-infra-auth
AUTH_JWT_AUDIENCE=go-infra-api
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_EXPIRY=15m
AUTH_JWT_REFRESH_EXPIRY=168h

# Password Configuration
AUTH_PASSWORD_HASH_ALGORITHM=bcrypt
AUTH_PASSWORD_BCRYPT_COST=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPER=false
AUTH_PASSWORD_REQUIRE_LOWER=false
AUTH_PASSWORD_REQUIRE_NUMBER=false
AUTH_PASSWORD_REQUIRE_SPECIAL=false

# Supported Authentication Schemes
# Identifier schemes: how users identify themselves
AUTH_SUPPORTED_IDENTIFIER_SCHEMES=username,email,phone

# Credential schemes: how users prove their identity
AUTH_SUPPORTED_CREDENTIAL_SCHEMES=basic
